    "appName": "Niels Autotrade",
    "webDir": "www",
    "bundledWebRuntime": false,
    "plugins": {
        "CapacitorCookies": {
            "enabled": true
        },
        "CapacitorHttp": {
            "enabled": true
        }
    },
    "server": {
